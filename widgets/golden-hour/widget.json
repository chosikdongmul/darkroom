{
  "id": "darkroom.golden-hour",
  "name": "골든아워",
  "description": "골든·블루아워까지 남은 시간과 노을 예보",
  "version": "0.2.0",
  "size": { "width": 360, "height": 214, "inset": 12 },
  "windowMode": "desktop",
  "subscribe": ["time.now", "sun.today", "sun.tomorrow", "sun.phase", "weather.sunset"],
  "permissions": ["network"],
  "settings": {
    "target": { "type": "choice", "options": ["골든아워", "블루아워", "둘 다"], "default": "둘 다", "label": "카운트다운 대상" }
  }
}
