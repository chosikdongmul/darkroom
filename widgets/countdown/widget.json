{
  "id": "darkroom.countdown",
  "name": "디데이",
  "description": "기다리는 날까지 남은 날 수 (D-day). 네이버 캘린더 일정도 함께",
  "version": "0.3.0",
  "entry": "index.html",
  "size": {
    "width": 360,
    "height": 168,
    "inset": 12
  },
  "windowMode": "desktop",
  "subscribe": [
    "time.now",
    "calendar.events"
  ],
  "permissions": [
    "calendar"
  ],
  "settings": {
    "events": {
      "type": "dates",
      "label": "날짜",
      "hint": "★를 누른 날을 크게 보여 줍니다. ★가 없으면 캘린더 일정까지 합쳐 가장 가까운 날을 보여 줍니다. 캘린더는 오른쪽 '캘린더'에서 연결합니다.",
      "maxItems": 20,
      "default": [
        {
          "date": "2026-12-25",
          "name": "크리스마스",
          "yearly": true,
          "pinned": false
        }
      ]
    },
    "countToday": {
      "type": "bool",
      "default": false,
      "label": "당일을 1일째로 세기"
    },
    "calendar": {
      "type": "choice",
      "label": "캘린더 일정",
      "options": [
        "allday",
        "all",
        "off"
      ],
      "optionLabels": [
        "하루 종일 일정만",
        "모든 일정",
        "가져오지 않음"
      ],
      "default": "allday"
    }
  }
}
