{
  "id": "darkroom.naver-map",
  "name": "지도",
  "description": "네이버 지도: 집↔회사 길찾기, 주변 지도",
  "version": "0.1.0",
  "entry": "index.html",
  "size": { "width": 360, "height": 560, "inset": 12 },
  "windowMode": "desktop",
  "subscribe": ["time.now"],
  "permissions": ["web"],
  "web": { "allow": ["naver.com", "naver.me"] },
  "settings": {
    "origin": { "type": "place", "label": "출발지", "hint": "찾은 뒤 이름 칸을 '집'처럼 바꾸면 위젯 버튼에 그 이름이 나옵니다." },
    "destination": { "type": "place", "label": "도착지" },
    "mode": { "type": "choice", "label": "길찾기 방법", "options": ["transit", "car", "walk"], "optionLabels": ["대중교통", "자동차", "도보"], "default": "transit" },
    "start": { "type": "choice", "label": "켤 때 보여 줄 화면", "options": ["auto", "around"], "optionLabels": ["길찾기 (오전엔 가는 길, 오후엔 오는 길)", "출발지 주변 지도"], "default": "auto" }
  }
}
