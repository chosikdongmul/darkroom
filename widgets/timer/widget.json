{
  "id": "darkroom.timer",
  "name": "타이머",
  "description": "공부·운동·요리용 타이머, 끝나면 알림",
  "version": "0.2.0",
  "entry": "index.html",
  "size": { "width": 360, "height": 168, "inset": 12 },
  "windowMode": "desktop",
  "subscribe": ["time.now"],
  "permissions": ["notify"],
  "settings": {
    "presets": { "type": "numbers", "label": "시간 버튼(분)", "hint": "4개까지. 위젯에서 눌러 바로 시작할 수 있습니다.", "min": 1, "max": 600, "maxItems": 4, "default": [5, 15, 25, 60] },
    "notify": { "type": "bool", "default": true, "label": "끝나면 Windows 알림" }
  }
}