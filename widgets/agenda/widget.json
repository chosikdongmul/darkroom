{
  "id": "darkroom.agenda",
  "name": "일정",
  "description": "다가오는 일정 (네이버 캘린더)",
  "version": "0.2.0",
  "entry": "index.html",
  "size": {
    "width": 360,
    "height": 214,
    "inset": 12
  },
  "windowMode": "desktop",
  "subscribe": [
    "time.now",
    "calendar.events"
  ],
  "permissions": [
    "calendar"
  ],
  "settings": {
    "showEnded": {
      "type": "bool",
      "default": false,
      "label": "오늘 끝난 일정도 보기"
    }
  }
}
