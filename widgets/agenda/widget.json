{
  "id": "darkroom.agenda",
  "name": "일정",
  "description": "오늘과 다가오는 일정 (네이버 캘린더)",
  "version": "0.1.0",
  "entry": "index.html",
  "size": { "width": 360, "height": 214, "inset": 12 },
  "windowMode": "desktop",
  "subscribe": ["time.now", "calendar.events"],
  "permissions": ["calendar"],
  "settings": {
    "days": { "type": "choice", "label": "보여 줄 기간", "options": ["1", "3", "7", "30"], "optionLabels": ["오늘만", "3일", "1주", "한 달"], "default": "7" },
    "showEnded": { "type": "bool", "default": false, "label": "오늘 끝난 일정도 보기" }
  }
}
