{
  "id": "darkroom.launcher",
  "name": "바로가기",
  "description": "자주 여는 앱·폴더·사이트를 한 번에",
  "version": "0.2.0",
  "entry": "index.html",
  "size": { "width": 360, "height": 196, "inset": 12 },
  "windowMode": "desktop",
  "subscribe": [],
  "permissions": ["launch"],
  "settings": {
    "items": {
      "type": "links",
      "label": "바로가기",
      "hint": "최대 8개. 위젯의 아이콘을 누르면 열립니다.",
      "maxItems": 8,
      "default": [
        { "name": "사진", "target": "shell:My Pictures" },
        { "name": "다운로드", "target": "shell:Downloads" },
        { "name": "메모장", "target": "%WINDIR%\\system32\\notepad.exe" },
        { "name": "계산기", "target": "%WINDIR%\\system32\\calc.exe" }
      ]
    }
  }
}